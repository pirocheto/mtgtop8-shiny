# Build-time configuration of the production bundle.
#
# It is baked into the bundle by Vite. It is not a secret, and it cannot be
# changed without rebuilding the image -- a SPA has no server
# side to read an environment variable at run time.

# Path prefix the SPA is served under behind a reverse proxy. Vite bakes it into
# every asset URL, so it has to be known at build time.
#
# Keep it equal to the path the reverse proxy routes to this service -- if it
# does not rewrite the path, a mismatch is a blank page with 404s on the assets. Set it to nothing to build
# for the root of a domain.
#
# This is the default. An environment that serves under another prefix
# overrides it with the image's BASE_PATH build arg.
VITE_BASE_PATH=/mtgtop8-shiny
