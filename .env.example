# Local development overrides. Copy to .env.local, which is gitignored:
#
#   cp .env.example .env.local
#
# Vite only exposes variables prefixed VITE_ to the bundle. .env.production
# holds the committed defaults of a production build; this file is for what
# differs on your machine.

# Path prefix to build for. Empty in dev; overriding it locally is mostly
# useful to reproduce a production build with `make preview`.
# VITE_BASE_PATH=

# The dev and preview servers proxy /mtgtop8 to the live mtgtop8.com. Set to
# true to answer from the saved pages in src/lib/mtgtop8/__fixtures__ instead,
# offline and on fixed data.
# MTGTOP8_MOCK=true

# With the mock on, how long it takes to answer each page, in ms, like the
# live site does, so the loaders show. 0 for instant answers.
# MTGTOP8_MOCK_DELAY=800
